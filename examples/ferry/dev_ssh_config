# ferry dev ssh config — the lima test boxes, selected with
# `-F ./ferry/dev_ssh_config`. ferry's default is the real ~/.ssh/config
# now (the entrySSHConfig const in main.go); this file is the safe target
# for manual testing so a stray click can't hit a production server.
#
# These hosts are local lima VMs styled as remote linux boxes.
#
# Create the boxes once (fixed ssh ports so this file stays valid; these
# exact commands worked with lima 2.1.3 — default template is Ubuntu LTS):
#
#   limactl create --name=ferry-a --tty=false --set '.ssh.localPort = 2281 | .cpus = 1 | .memory = "1GiB" | .disk = "8GiB"'
#   limactl create --name=ferry-b --tty=false --set '.ssh.localPort = 2282 | .cpus = 1 | .memory = "1GiB" | .disk = "8GiB"'
#   limactl create --name=ferry-c --tty=false --set '.ssh.localPort = 2283 | .cpus = 1 | .memory = "1GiB" | .disk = "8GiB"'
#   limactl start ferry-a --tty=false    # b and c can stay stopped until needed
#
# Lima's default in-VM user is the host username (home /home/<user>.guest);
# its shared user key is ~/.lima/_config/user (no passphrase).

Host ferry-a
  HostName 127.0.0.1
  Port 2281
  User hasen
  IdentityFile ~/.lima/_config/user

Host ferry-b
  HostName 127.0.0.1
  Port 2282
  User hasen
  IdentityFile ~/.lima/_config/user

Host ferry-c
  HostName 127.0.0.1
  Port 2283
  User hasen
  IdentityFile ~/.lima/_config/user

# ferry-pw is ferry-c's password-only side door: a user with no
# authorized_keys, so publickey fails and the client must fall back to
# password auth. Password: ferry123 (throwaway dev box, fine to commit).
# Setup, done once on ferry-c (the 10- prefix beats cloud-init's
# 60-cloudimg-settings.conf — sshd takes the FIRST value it sees):
#
#   limactl shell ferry-c sudo useradd -m -s /bin/bash pwuser
#   limactl shell ferry-c sudo sh -c "echo 'pwuser:ferry123' | chpasswd"
#   limactl shell ferry-c sudo sh -c "printf 'PasswordAuthentication yes\n' > /etc/ssh/sshd_config.d/10-ferry-password.conf"
#   limactl shell ferry-c sudo systemctl restart ssh

Host ferry-pw
  HostName 127.0.0.1
  Port 2283
  User pwuser
